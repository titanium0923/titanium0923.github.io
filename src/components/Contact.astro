---
// src/components/Contact.astro
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const email = "lubava.spotifay@mail.ru";
const github = "titanium0923";
---

<section class="py-24 sm:py-32 border-t border-border bg-accent/5 relative overflow-hidden" id="contact">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 relative z-10">
    <div class="text-center mb-20">
      <h2 class="text-6xl sm:text-8xl md:text-[10rem] font-bold tracking-tighter leading-none hover:text-accent transition-colors duration-500 cursor-default">
        Давайте<br/>работать
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 max-w-5xl mx-auto">
      
      <!-- Контакты и кнопка копирования -->
      <div class="flex flex-col gap-8">
        <h3 class="text-2xl font-medium tracking-tight">Связаться со мной</h3>
        
        <div class="flex flex-col items-start gap-4">
          <button id="copy-email-btn" data-email={email} class="group flex items-center gap-4 px-6 py-4 rounded-2xl border border-border bg-bg hover:border-accent transition-colors text-left relative overflow-hidden">
            <div class="absolute inset-0 bg-accent/5 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
            <div class="relative z-10 flex flex-col">
              <span class="text-sm text-text/50 font-medium uppercase tracking-widest mb-1" id="copy-status">Email</span>
              <span class="text-lg sm:text-xl font-medium">{email}</span>
            </div>
            <svg class="relative z-10 ml-4 opacity-50 group-hover:opacity-100 group-hover:text-accent transition-all" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          </button>

          <a href={`https://github.com/${github}`} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 px-6 py-4 rounded-2xl border border-border bg-bg hover:border-accent transition-colors text-left relative overflow-hidden w-full sm:w-auto">
             <div class="absolute inset-0 bg-accent/5 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
             <div class="relative z-10 flex flex-col">
              <span class="text-sm text-text/50 font-medium uppercase tracking-widest mb-1">GitHub</span>
              <span class="text-lg font-medium">@{github}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Форма Formspree (Показывается только если задан ID) -->
      {formspreeId ? (
        <form action={`https://formspree.io/f/${formspreeId}`} method="POST" class="flex flex-col gap-4">
          <div class="flex flex-col gap-2">
            <label for="name" class="text-sm font-medium text-text/70 uppercase tracking-widest">Имя</label>
            <input type="text" id="name" name="name" required class="bg-bg border border-border rounded-xl px-5 py-4 focus:outline-none focus:border-accent transition-colors" placeholder="Как к вам обращаться?" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-sm font-medium text-text/70 uppercase tracking-widest">Email</label>
            <input type="email" id="email" name="email" required class="bg-bg border border-border rounded-xl px-5 py-4 focus:outline-none focus:border-accent transition-colors" placeholder="Ваша почта для связи" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="message" class="text-sm font-medium text-text/70 uppercase tracking-widest">Сообщение</label>
            <textarea id="message" name="message" required rows="4" class="bg-bg border border-border rounded-xl px-5 py-4 focus:outline-none focus:border-accent transition-colors resize-none" placeholder="Расскажите о вашей задаче..."></textarea>
          </div>
          <button type="submit" class="mt-2 bg-text text-bg font-medium px-8 py-4 rounded-xl hover:bg-accent transition-colors">
            Отправить сообщение
          </button>
        </form>
      ) : (
        <div class="flex items-center justify-center h-full p-8 border border-dashed border-border rounded-3xl bg-bg/50 text-text/50 font-medium text-center">
          Форма обратной связи скрыта.
        </div>
      )}

    </div>
  </div>
</section>

<!-- Футер -->
<footer class="py-8 border-t border-border bg-bg text-center text-sm font-medium text-text/50">
  <div class="container mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p>&copy; {new Date().getFullYear()} Амирхан Туленов.</p>
    <a href="https://github.com/titanium0923/titanium0923.github.io" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
      Исходный код сайта
    </a>
  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('copy-email-btn');
    const statusText = document.getElementById('copy-status');
    
    if (btn && statusText) {
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email') || '';
        try {
          await navigator.clipboard.writeText(email);
          statusText.textContent = 'Скопировано!';
          statusText.classList.add('text-accent');
          setTimeout(() => {
            statusText.textContent = 'Email';
            statusText.classList.remove('text-accent');
          }, 2000);
        } catch (err) {
          console.error('Ошибка копирования', err);
        }
      });
    }
  });
</script>